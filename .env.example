# Copy this file to .env.local and fill in real values.
# Without VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY the app crashes on load
# (Supabase client is constructed at import time).

# Required — Supabase project (Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Required for AI-scored tests (WAT/SRT practice & full tests)
ANTHROPIC_API_KEY=

# Optional — omit in dev to use the mock-purchase fallback in src/routes/pricing.tsx
VITE_RAZORPAY_KEY_ID=
